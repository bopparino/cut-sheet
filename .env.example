# Path to the SQLite database file. Defaults to ./data/cutsheets.db in dev.
DATABASE_PATH=./data/cutsheets.db

# Directory for uploaded drawings/photos. Defaults to ./uploads in dev.
UPLOADS_DIR=./uploads

# Bearer token for the read-only Ariya agent API (/api/ariya/*). Unset = the
# whole API answers 503 (dormant, same posture as the Salesforce integration).
# ARIYA_API_TOKEN=
